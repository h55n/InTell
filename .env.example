# ════════════════════════════════════════════════════════════════
# PHONE INTEL — Environment Configuration
# ════════════════════════════════════════════════════════════════

# ── REQUIRED: Mistral AI ─────────────────────────────────────────
# Get your key at: https://console.mistral.ai/
# All 5 agents + orchestrator synthesis use Mistral.
MISTRAL_API_KEY=your_mistral_api_key_here

# Model to use (mistral-large-latest is recommended for best results)
# Options: mistral-large-latest | mistral-medium-latest | open-mistral-7b
MISTRAL_MODEL=mistral-large-latest

# ── RECOMMENDED: Search API (pick ONE) ───────────────────────────

# Option A: Serper (Google search results — best quality)
# Get free 2,500 searches/month at: https://serper.dev
# When set, all agents use real Google results.
SERPER_API_KEY=your_serper_api_key_here

# Option B: Tavily (AI-optimized search)
# Get free 1,000 searches/month at: https://tavily.com
# Used as fallback if Serper is not set.
# TAVILY_API_KEY=your_tavily_api_key_here

# NOTE: If neither is set, falls back to DuckDuckGo instant API
# (no key required, but limited results — not recommended for production)

# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────
# Investigations are expensive (many API calls). Keep this low.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# ── Persistence (optional — graceful fallback to in-memory if not set) ──────
# Redis: get free tier at https://redis.io/try-free/ or upstash.com
# REDIS_URL=redis://default:password@host:6379

# PostgreSQL: get free tier at supabase.com (audit log & analytics)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Cost Control ──────────────────────────────────────────────────
# Max web search iterations per agent (higher = more thorough, more expensive)
MAX_SEARCH_ITERATIONS=12

# How long to cache reports (seconds). Default 24 hours.
REPORT_TTL_SECONDS=86400

# ── PDF Export (optional) ─────────────────────────────────────────
# Only needed when running in Docker or if auto-downloaded Chromium fails.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
